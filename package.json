{
  "name": "recpro",
  "private": true,
  "version": "0.1.0",
  "description": "Private, offline photo and video organizer with local AI.",
  "workspaces": [
    "ui",
    "desktop"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ui": "npm run dev -w ui",
    "build": "npm run build -w ui && npm run build -w desktop",
    "typecheck": "npm run typecheck -w ui && npm run typecheck -w desktop",
    "test:ui": "npm run test -w ui",
    "test:engine": "cd engine && uv run pytest -q"
  },
  "overrides": {
    "d3-array": "3.2.4",
    "d3-color": "3.1.0",
    "d3-dispatch": "3.0.1",
    "d3-drag": "3.0.0",
    "d3-ease": "3.0.1",
    "d3-geo": "3.1.1",
    "d3-interpolate": "3.0.1",
    "d3-selection": "3.0.0",
    "d3-timer": "3.0.1",
    "d3-transition": "3.0.1",
    "d3-zoom": "3.0.0"
  }
}
